{
  "name": "studydeck",
  "productName": "StudyDeck",
  "version": "1.2.0",
  "description": "Flashcards personnelles avec répétition espacée (hors ligne, sans cloud)",
  "author": "StudyDeck",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/make-sw.mjs",
    "test": "vitest run",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:installer": "npm run build && electron-builder --win --x64 --config.win.target=nsis --config.win.target=portable"
  },
  "build": {
    "appId": "local.studydeck.app",
    "productName": "StudyDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "StudyDeck-Installateur-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StudyDeck-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.18",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}